APP_NAME="ShipYard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=server_management
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the longest-running job's timeout, not just the average one.
# If it doesn't, Redis considers a still-running job abandoned and hands it
# to the next worker that polls, running it a second time while the first is
# still going. The database restore job is the longest job in this app
# (BackupRestoreService::MAX_RESTORE_SECONDS, 2700s at last count), so this
# must stay above that.
REDIS_QUEUE_RETRY_AFTER=3600

CACHE_STORE=redis
CACHE_PREFIX=server_mgmt

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# Admin credentials (used during initial seeding)
# These are set by the install script
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
